{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solarplexus:mobius:milestone-7.8:controller:v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subscriptionId",
    "tenantId",
    "campaignId",
    "generationId",
    "subscriptionCorrelation",
    "sourceHead",
    "controllerLocation",
    "controllerResourceGroupName",
    "automationAccountName",
    "runbookName",
    "controllerAuthorizedUntilUtc",
    "cleanupScriptSha256",
    "freshControllerAdmissionEvidenceSha256",
    "freshControllerAdmissionEvidenceVersion",
    "deploymentName"
  ],
  "properties": {
    "subscriptionId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "format": "uuid" },
    "campaignId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{7,47}$" },
    "generationId": { "type": "string", "pattern": "^g[1-9][0-9]{0,5}-[a-f0-9]{12}$" },
    "subscriptionCorrelation": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "sourceHead": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "controllerLocation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,31}$"
    },
    "controllerResourceGroupName": {
      "type": "string",
      "pattern": "^rg-m78-controller-[a-f0-9]{10}$"
    },
    "automationAccountName": {
      "type": "string",
      "pattern": "^aa-m78-controller-[a-f0-9]{10}$"
    },
    "runbookName": { "const": "Remove-M78Campaign" },
    "controllerAuthorizedUntilUtc": { "type": "string", "format": "date-time" },
    "cleanupScriptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "freshControllerAdmissionEvidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "freshControllerAdmissionEvidenceVersion": {
      "const": "m7.8-fresh-subscription-predeployment-absence-evidence-v1"
    },
    "deploymentName": {
      "type": "string",
      "pattern": "^m78-controller-[a-f0-9]{10}$"
    }
  }
}
