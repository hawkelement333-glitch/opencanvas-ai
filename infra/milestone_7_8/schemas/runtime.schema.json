{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solarplexus:mobius:milestone-7.8:operator-runtime:v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subscriptionId",
    "sourceHead",
    "canonicalBuildInputSha256",
    "dockerfileSha256",
    "cleanupScriptSha256",
    "automationApiVersion",
    "cleanupControllerArchitecture",
    "cleanupControllerArmability",
    "controllerBindingSha256",
    "cleanupAuthorityExpiresUtc",
    "cleanupRegion",
    "cleanupRegionSelectionSha256",
    "cleanupCandidateRegions",
    "cleanupOfferClassification",
    "cleanupOfferEligibilityDisposition",
    "cleanupOfferEligibleRegions",
    "cleanupOfferEligibilitySource",
    "cleanupOfferEligibilitySha256",
    "cleanupRegionSelectionFile",
    "cleanupDeploymentName",
    "campaignDeploymentName",
    "automationAccountName",
    "runbookName",
    "scheduleName",
    "bindingName",
    "bootstrapJobName",
    "migrationJobName",
    "workerJobName",
    "evidenceJobName",
    "apiProbeJobName",
    "workerProbeJobName",
    "migrationProbeJobName",
    "recoveryJobName",
    "recoveryRestoreJobName",
    "postgresServerName",
    "registryName",
    "logAnalyticsWorkspaceName",
    "resourceGroupName",
    "cleanupResourceGroupName",
    "cleanupParametersFile",
    "campaignParametersFile"
  ],
  "properties": {
    "subscriptionId": { "type": "string", "minLength": 1 },
    "sourceHead": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "canonicalBuildInputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dockerfileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cleanupScriptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "automationApiVersion": { "const": "2024-10-23" },
    "cleanupControllerArchitecture": {
      "const": "reusable-automation-controller-v1"
    },
    "cleanupControllerArmability": {
      "const": "architecture-corrected-live-execution-not-authorized"
    },
    "controllerBindingSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cleanupAuthorityExpiresUtc": { "type": "string", "format": "date-time" },
    "cleanupRegion": { "type": "string", "pattern": "^[a-z][a-z0-9]{2,31}$" },
    "cleanupRegionSelectionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cleanupCandidateRegions": {
      "const": "eastus2,southcentralus,westus2,westus,eastus,northeurope,southeastasia"
    },
    "cleanupOfferClassification": {
      "enum": ["restricted-public-offer", "unclassified"]
    },
    "cleanupOfferEligibilityDisposition": {
      "enum": [
        "restricted-offer-metadata-confirmed",
        "restrictive-public-baseline-applied"
      ]
    },
    "cleanupOfferEligibleRegions": {
      "const": "eastus,eastus2,northeurope,southeastasia,westus"
    },
    "cleanupOfferEligibilitySource": {
      "const": "microsoft-automation-restricted-public-offer-regions-2026-08-v1"
    },
    "cleanupOfferEligibilitySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cleanupRegionSelectionFile": { "type": "string", "minLength": 1 },
    "cleanupDeploymentName": { "type": "string", "minLength": 1 },
    "campaignDeploymentName": { "type": "string", "minLength": 1 },
    "automationAccountName": {
      "type": "string",
      "pattern": "^aa-m78-controller-[a-f0-9]{10}$"
    },
    "runbookName": { "const": "Remove-M78Campaign" },
    "scheduleName": {
      "type": "string",
      "pattern": "^m78-deadline-[a-f0-9]{10}$"
    },
    "bindingName": { "type": "string", "format": "uuid" },
    "bootstrapJobName": { "type": "string", "minLength": 1 },
    "migrationJobName": { "type": "string", "minLength": 1 },
    "workerJobName": { "type": "string", "minLength": 1 },
    "evidenceJobName": { "type": "string", "minLength": 1 },
    "apiProbeJobName": { "type": "string", "minLength": 1 },
    "workerProbeJobName": { "type": "string", "minLength": 1 },
    "migrationProbeJobName": { "type": "string", "minLength": 1 },
    "recoveryJobName": { "type": "string", "minLength": 1 },
    "recoveryRestoreJobName": { "type": "string", "minLength": 1 },
    "postgresServerName": { "type": "string", "minLength": 1 },
    "registryName": { "type": "string", "minLength": 5 },
    "logAnalyticsWorkspaceName": { "type": "string", "minLength": 1 },
    "resourceGroupName": { "type": "string", "minLength": 1 },
    "cleanupResourceGroupName": {
      "type": "string",
      "pattern": "^rg-m78-controller-[a-f0-9]{10}$"
    },
    "cleanupParametersFile": { "type": "string", "minLength": 1 },
    "campaignParametersFile": { "type": "string", "minLength": 1 }
  }
}
