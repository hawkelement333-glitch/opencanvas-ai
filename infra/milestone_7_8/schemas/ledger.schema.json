{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solarplexus:mobius:milestone-7.8:campaign-ledger:v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "generation_id",
    "phase",
    "authorized_ceiling_usd",
    "conservative_estimate_usd",
    "contingency_percent",
    "first_billable_mutation_utc",
    "cleanup_deadline_utc",
    "original_cleanup_deadline_utc",
    "resource_generation_count",
    "image_generation_count",
    "image_digest",
    "required_scan_count",
    "image_scan_count",
    "image_scan_evidence_sha256",
    "transitions",
    "cleanup_started_utc",
    "cleanup_completed_utc",
    "actual_cost_usd",
    "cleanup_arm_evidence_sha256",
    "cleanup_disarm_evidence_sha256",
    "cleanup_disposition",
    "residue_evidence_sha256",
    "residue",
    "cleanup_region",
    "cleanup_region_selection_sha256",
    "cleanup_candidate_regions",
    "cleanup_offer_classification",
    "cleanup_offer_eligibility_disposition",
    "cleanup_offer_eligible_regions",
    "cleanup_offer_eligibility_source",
    "cleanup_offer_eligibility_sha256",
    "fresh_controller_admission_evidence_sha256"
  ],
  "properties": {
    "campaign_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{7,47}$" },
    "generation_id": {
      "type": "string",
      "pattern": "^g[1-9][0-9]{0,5}-[a-f0-9]{12}$"
    },
    "phase": { "type": "string" },
    "authorized_ceiling_usd": { "const": "50.00" },
    "conservative_estimate_usd": { "type": "string" },
    "contingency_percent": { "type": "string" },
    "first_billable_mutation_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "cleanup_deadline_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "original_cleanup_deadline_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "resource_generation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "image_generation_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "image_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "required_scan_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "image_scan_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "image_scan_evidence_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "transitions": { "type": "array" },
    "cleanup_started_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "cleanup_completed_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "actual_cost_usd": { "type": ["string", "null"] },
    "cleanup_arm_evidence_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "cleanup_disarm_evidence_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "cleanup_disposition": {
      "enum": [
        "pending",
        "zero-residue",
        "nonzero-residue"
      ]
    },
    "residue_evidence_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetResourceGroups",
        "cleanupResourceGroups",
        "roleAssignments",
        "cleanupSchedules",
        "managedIdentities",
        "postgresServers",
        "containerRegistries",
        "containerAppsEnvironments",
        "containerAppsJobs",
        "virtualNetworks",
        "privateEndpoints",
        "privateDnsZones",
        "diagnosticSettings",
        "syntheticRows"
      ],
      "properties": {
        "targetResourceGroups": { "type": "integer", "minimum": 0 },
        "cleanupResourceGroups": { "type": "integer", "minimum": 0 },
        "roleAssignments": { "type": "integer", "minimum": 0 },
        "cleanupSchedules": { "type": "integer", "minimum": 0 },
        "managedIdentities": { "type": "integer", "minimum": 0 },
        "postgresServers": { "type": "integer", "minimum": 0 },
        "containerRegistries": { "type": "integer", "minimum": 0 },
        "containerAppsEnvironments": { "type": "integer", "minimum": 0 },
        "containerAppsJobs": { "type": "integer", "minimum": 0 },
        "virtualNetworks": { "type": "integer", "minimum": 0 },
        "privateEndpoints": { "type": "integer", "minimum": 0 },
        "privateDnsZones": { "type": "integer", "minimum": 0 },
        "diagnosticSettings": { "type": "integer", "minimum": 0 },
        "syntheticRows": { "type": "integer", "minimum": 0 }
      }
    },
    "cleanup_region": { "type": "string", "pattern": "^[a-z][a-z0-9]{2,31}$" },
    "cleanup_region_selection_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cleanup_candidate_regions": {
      "const": "eastus2,southcentralus,westus2,westus,eastus,northeurope,southeastasia"
    },
    "cleanup_offer_classification": {
      "enum": ["restricted-public-offer", "unclassified"]
    },
    "cleanup_offer_eligibility_disposition": {
      "enum": [
        "restricted-offer-metadata-confirmed",
        "restrictive-public-baseline-applied"
      ]
    },
    "cleanup_offer_eligible_regions": {
      "const": "eastus,eastus2,northeurope,southeastasia,westus"
    },
    "cleanup_offer_eligibility_source": {
      "const": "microsoft-automation-restricted-public-offer-regions-2026-08-v1"
    },
    "cleanup_offer_eligibility_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fresh_controller_admission_evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
