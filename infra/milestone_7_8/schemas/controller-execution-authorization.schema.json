{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solarplexus:mobius:milestone-7.8:controller-execution-authorization:v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "disposition",
    "operation",
    "subscriptionCorrelation",
    "sourceHead",
    "controllerArchitecture",
    "controllerLocation",
    "controllerResourceGroupName",
    "automationAccountName",
    "controllerAuthorizedUntilUtc",
    "retentionAbsenceEvidenceSha256",
    "retentionAbsenceEvidenceVersion",
    "expiresAtUtc",
    "authorizationSha256"
  ],
  "properties": {
    "version": { "const": "m7.8-controller-execution-authorization-v3" },
    "disposition": { "const": "separately-authorized-controller-execution" },
    "operation": { "enum": ["controller-bootstrap", "controller-verify"] },
    "subscriptionCorrelation": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "sourceHead": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "controllerArchitecture": { "const": "reusable-automation-controller-v1" },
    "controllerLocation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,31}$"
    },
    "controllerResourceGroupName": {
      "type": "string",
      "pattern": "^rg-m78-controller-[a-f0-9]{10}$"
    },
    "automationAccountName": {
      "type": "string",
      "pattern": "^aa-m78-controller-[a-f0-9]{10}$"
    },
    "controllerAuthorizedUntilUtc": { "type": "string", "format": "date-time" },
    "retentionAbsenceEvidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "retentionAbsenceEvidenceVersion": {
      "const": "m7.8-retained-automation-absence-verification-v3"
    },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "authorizationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
