{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solarplexus:mobius:milestone-7.8:cleanup-region-selection:v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "candidateOrder",
    "selectedRegion",
    "providerRegistrationState",
    "capacityBasis",
    "controllerDisposition",
    "controllerRegion",
    "policyAssignmentCount",
    "policyDefinitionCount",
    "providerLocationsSha256",
    "offerClassification",
    "offerEligibilityDisposition",
    "offerEligibleRegions",
    "offerEligibilitySource",
    "offerEligibilitySha256",
    "activeOccupancySha256",
    "softDeletedOccupancySha256",
    "policyEvidenceSha256",
    "retentionAbsenceEvidenceSha256",
    "observedAtUtc",
    "candidates"
  ],
  "properties": {
    "version": { "const": "m7.8-cleanup-region-selection-v5" },
    "candidateOrder": {
      "const": [
        "eastus2",
        "southcentralus",
        "westus2",
        "westus",
        "eastus",
        "northeurope",
        "southeastasia"
      ]
    },
    "selectedRegion": { "type": "string", "pattern": "^[a-z][a-z0-9]{2,31}$" },
    "providerRegistrationState": { "const": "Registered" },
    "capacityBasis": {
      "const": "provider-offer-policy-exact-controller-or-zero-occupancy"
    },
    "controllerDisposition": {
      "enum": ["controller-absent", "exact-controller-adoptable"]
    },
    "controllerRegion": {
      "type": "string",
      "pattern": "^$|^[a-z][a-z0-9]{2,31}$"
    },
    "policyAssignmentCount": { "type": "integer", "minimum": 0 },
    "policyDefinitionCount": { "type": "integer", "minimum": 0 },
    "providerLocationsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "offerClassification": {
      "enum": ["restricted-public-offer", "unclassified"]
    },
    "offerEligibilityDisposition": {
      "enum": [
        "restricted-offer-metadata-confirmed",
        "restrictive-public-baseline-applied"
      ]
    },
    "offerEligibleRegions": {
      "const": ["eastus", "eastus2", "northeurope", "southeastasia", "westus"]
    },
    "offerEligibilitySource": {
      "const": "microsoft-automation-restricted-public-offer-regions-2026-08-v1"
    },
    "offerEligibilitySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "activeOccupancySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "softDeletedOccupancySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyEvidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "retentionAbsenceEvidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtUtc": { "type": "string", "format": "date-time" },
    "candidates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region",
          "providerSupported",
          "offerEligible",
          "policyAllowed",
          "activeAccountCount",
          "adoptableControllerCount",
          "softDeletedAccountCount",
          "status"
        ],
        "properties": {
          "region": { "type": "string", "pattern": "^[a-z][a-z0-9]{2,31}$" },
          "providerSupported": { "type": "boolean" },
          "offerEligible": { "type": "boolean" },
          "policyAllowed": { "type": "boolean" },
          "activeAccountCount": { "type": "integer", "minimum": 0 },
          "adoptableControllerCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "softDeletedAccountCount": { "type": "integer", "minimum": 0 },
          "status": {
            "enum": [
              "viable",
              "unsupported",
              "offer-ineligible",
              "policy-disallowed",
              "occupied",
              "controller-region-mismatch"
            ]
          }
        }
      }
    }
  }
}
