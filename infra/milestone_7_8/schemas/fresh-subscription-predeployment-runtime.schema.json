{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solarplexus:mobius:milestone-7.8:fresh-subscription-predeployment-runtime:v1",
  "title": "Milestone 7.8 fresh subscription predeployment runtime",
  "description": "Private, ignored binding for one fresh subscription's read-only predeployment inventory check. It is not campaign runtime or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "subscriptionId",
    "tenantId",
    "campaignId",
    "generationId",
    "region",
    "controllerResourceGroupName",
    "automationAccountName"
  ],
  "properties": {
    "version": { "const": "m7.8-fresh-subscription-predeployment-runtime-v1" },
    "subscriptionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "campaignId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{7,47}$" },
    "generationId": { "type": "string", "pattern": "^g[1-9][0-9]{0,5}-[a-f0-9]{12}$" },
    "region": { "type": "string", "pattern": "^[a-z][a-z0-9]{2,31}$" },
    "controllerResourceGroupName": {
      "type": "string",
      "pattern": "^rg-m78-controller-[a-f0-9]{10}$"
    },
    "automationAccountName": {
      "type": "string",
      "pattern": "^aa-m78-controller-[a-f0-9]{10}$"
    }
  }
}
