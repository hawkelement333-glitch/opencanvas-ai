    "storage": {
      "name": "Standard_LRS",
      "kind": "StorageV2",
      "minimumTlsVersion": "TLS1_2",
      "allowSharedKeyAccess": false,
      "allowAnonymousAccess": false,
      "publicNetworkAccess": false,
      "versioningEnabled": true,
      "defenderMonthlyCapGiB": 1,
      "scannerExerciseObjectCap": 25,
