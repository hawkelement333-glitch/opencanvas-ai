{
  "$schema": "scanner-result-bridge.schema.json",
  "contractVersion": "m7.7-scanner-result-bridge-v2",
  "resolutionStatus": "private-pull-implementation-complete-live-proof-required",
  "provider": {
    "name": "microsoft-defender-for-storage-malware-scanning",
    "resourceType": "Microsoft.Security/defenderForStorageSettings",
    "apiVersion": "2025-06-01",
    "resultSources": ["blob-index-tags", "StorageMalwareScanningResults"],
    "diagnosticCategory": "ScanResults",
    "providerManagedSystemTopic": "preserve-unmodified",
    "providerRegistration": "Microsoft.Security"
  },
  "producer": {
    "storageContainer": "quarantine",
    "immutableBinding": ["storageAccountName", "blobUri", "blobVersionId", "etag", "contentSha256"],
    "correlation": ["storageAccountName", "blobUri", "etag", "scanResult", "scanFinishedTimeUtc"],
    "noFilenameOnlyMatching": true
  },
  "transport": {
    "kind": "private-blob-tags-plus-ampls-log-analytics-pull",
    "blobTagKeys": ["Malware scanning scan result", "Malware scanning scan time UTC"],
    "logAnalyticsTable": "StorageMalwareScanningResults",
    "logAnalyticsColumns": ["StorageAccountName", "ScannedObjectUri", "ScannedObjectEtag", "ScanResultType", "CorrelationId", "ScanFinishedTimeUtc", "TimeGenerated"],
    "privateLinkScopeResourceType": "Microsoft.Insights/privateLinkScopes",
    "queryAccessMode": "PrivateOnly",
    "ingestionAccessMode": "PrivateOnly",
    "noCustomEventGridTopic": true,
    "noEventSubscription": true,
    "noQueue": true,
    "publicFallback": false
  },
  "consumer": {
    "entryPoint": "scripts.worker.DocumentWorker",
    "adapter": "opencanvas_api.services.scanner_bridge.PrivateScannerResultBridgeConsumer",
    "service": "MalwareScanService.record_bridge_result",
    "authentication": "worker-managed-identity-data-plane-read-only",
    "legacyHmacCallbackIsNotTransportAuthentication": true,
    "idempotency": "correlationId-plus-objectVersionId",
    "promotion": "only-clean-exact-dual-source-immutable-object-version",
    "maliciousDisposition": "rejected",
    "uncertainDisposition": "quarantine"
  },
  "identities": [
    {"alias": "api", "scope": "exact-upload-and-clean-containers", "blobTagsRead": false, "blobTagsWrite": false},
    {"alias": "scan-worker", "scope": "exact-quarantine-and-clean-containers-plus-workspace", "blobTagsRead": true, "blobTagsWrite": false}
  ],
  "network": {
    "blobPrivateEndpoint": true,
    "azureMonitorPrivateLinkScope": true,
    "privateDnsZones": ["privatelink.blob.core.windows.net", "privatelink.monitor.azure.com", "privatelink.oms.opinsights.azure.com", "privatelink.ods.opinsights.azure.com", "privatelink.agentsvc.azure-automation.net"],
    "containerAppInternalOnly": true,
    "tls": "TLS1_2-or-later",
    "publicNetworkAccess": false
  },
  "resolver": {
    "implementation": "preflight.milestone_7_7.scanner_result_bridge.resolve_bridge",
    "booleanMayBeTrueOnlyWhen": "RESOLVED",
    "states": ["CONTRACT_UNDEFINED", "PROVIDER_UNAVAILABLE", "RESOURCES_UNDEPLOYED", "IDENTITY_UNPROVED", "RBAC_UNPROVED", "PRIVATE_PATH_UNPROVED", "PRODUCER_UNPROVED", "TRANSPORT_UNPROVED", "CONSUMER_UNPROVED", "SCHEMA_UNPROVED", "CORRELATION_UNPROVED", "REVOCATION_UNPROVED", "STALE_EVIDENCE", "RESOLVED"]
  },
  "proof": {
    "jobKind": "bounded-container-apps-job",
    "failureMarkerSchema": "mobius.scanner-result-bridge.proof-failure.v1",
    "requiredDecisions": ["clean", "malicious", "missing", "error", "not-scanned", "conflict", "stale"],
    "privateDnsReadback": true,
    "retainedConsoleDiagnosticCategory": "ContainerAppConsoleLogs",
    "retainedConsoleDiagnosticScope": "managed-environment",
    "temporaryProbeAuthorityRevoked": true,
    "sanitizedEvidenceOnly": true
  },
  "cleanup": {
    "inventory": ["defenderForStorageSettings", "diagnosticSettings", "privateLinkScopes", "scopedResources", "privateEndpoints", "privateDnsZones", "roleDefinitions", "roleAssignments", "proofJobs"],
    "zeroResidueRequiresEveryTemporaryEntryAbsent": true
  },
  "provisioningAuthorized": true
}
