{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solarplexus:mobius:milestone-7.7:managed-binding:v1",
  "title": "Milestone 7.7 managed provider binding contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contractVersion",
    "authorizationSourceHead",
    "location",
    "cleanupLocation",
    "redisLocation",
    "accountBinding",
    "defaultAuthority",
    "resourceGroups",
    "scopeBinding",
    "resources",
    "cleanupExecution",
    "fixedSkus",
    "network",
    "networkQuotaRequirements",
    "providerApiVersions",
    "providerRegistrationRequirements",
    "rbac",
    "vpn",
    "providerRuntime",
    "privateAcrSource",
    "secrets",
    "manualSecretEntry",
    "lifecycle",
    "oneRunPolicy"
  ],
  "properties": {
    "$schema": { "const": "managed-binding.schema.json" },
    "contractVersion": { "const": "m7.7-managed-binding-v1" },
    "authorizationSourceHead": {
      "const": "11564669bd5b40a88fdbf434c8137b063305eb4b"
    },
    "location": { "const": "southcentralus" },
    "cleanupLocation": { "const": "westus" },
    "redisLocation": { "const": "australiacentral" },
    "accountBinding": { "$ref": "#/$defs/closedMap" },
    "defaultAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionAuthorized",
        "mutationAuthorized",
        "provisioningAuthorized",
        "secretAccessAuthorized"
      ],
      "properties": {
        "executionAuthorized": { "const": false },
        "mutationAuthorized": { "const": false },
        "provisioningAuthorized": { "const": false },
        "secretAccessAuthorized": { "const": false }
      }
    },
    "resourceGroups": { "$ref": "#/$defs/stringMap" },
    "scopeBinding": { "$ref": "#/$defs/stringMap" },
    "resources": { "$ref": "#/$defs/stringMap" },
    "cleanupExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizationParameter",
        "authorizationValue",
        "bindingContractVersion",
        "bindingGeneration",
        "activeBindingId",
        "corruptedAutomationAccount",
        "tombstonedBindingIds",
        "scheduleResourceId",
        "runbookResourceId",
        "targetResourceGroupId",
        "targetParameter",
        "targetResourceGroup",
        "subscriptionFingerprint",
        "deadlineUtc",
        "launchGraceSeconds",
        "cleanupContributorRoleDefinitionId",
        "cleanupPrincipalFingerprintSha256",
        "deletionWaitSeconds",
        "absenceVerificationSeconds",
        "publishedContentSha256"
      ],
      "properties": {
        "authorizationParameter": { "const": "CleanupAuthorized" },
        "authorizationValue": { "const": true },
        "bindingContractVersion": {
          "const": "m7.7-automation-cleanup-binding-v4"
        },
        "bindingGeneration": { "const": 4 },
        "activeBindingId": { "$ref": "#/$defs/guid" },
        "corruptedAutomationAccount": { "const": "aa-mobius77-cleanup" },
        "tombstonedBindingIds": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bindingContractVersion",
              "bindingGeneration",
              "bindingId",
              "directGetStatus",
              "listVisibility",
              "recreationStatus",
              "deletionStatus",
              "evidenceIntegritySha256"
            ],
            "properties": {
              "bindingContractVersion": {
                "enum": [
                  "m7.7-automation-cleanup-binding-v1",
                  "m7.7-automation-cleanup-binding-v2",
                  "m7.7-automation-cleanup-binding-v3",
                  "m7.7-automation-cleanup-binding-v4"
                ]
              },
              "bindingGeneration": { "enum": [1, 2, 3, 4] },
              "bindingId": {
                "enum": [
                  "158cac88-5679-5804-9f4d-854520bbb635",
                  "b74c6cfe-995e-5107-9e42-4f7f76b76742",
                  "f61544fe-cd79-5247-ac8b-ee9697b6ffd6",
                  "ecdbb32f-9134-5697-85f9-d569ba57454b",
                  "d83b4107-54e0-57a4-b650-fe0b556132d2",
                  "5ffc55c1-7a88-5231-b0d1-e76ee95d057e",
                  "a5429a32-87e3-5963-8c3a-bef85e777ed5",
                  "f29ca20d-cd14-57d9-b99b-fd6b04406166",
                  "12f27fa6-2cd5-548d-be20-c6e03a5e19d3",
                  "34b1d170-652b-505a-9cc1-b8177b872ff0"
                ]
              },
              "directGetStatus": { "const": "not-found" },
              "listVisibility": { "const": "absent" },
              "recreationStatus": { "enum": ["conflict", "not-attempted"] },
              "deletionStatus": { "enum": ["accepted", "not-attempted"] },
              "evidenceIntegritySha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "scheduleResourceId": {
          "const": "Microsoft.Automation/automationAccounts/aa-mobius77-cleanup-recovery/schedules/schedule-mobius77-cleanup-g4"
        },
        "runbookResourceId": {
          "const": "Microsoft.Automation/automationAccounts/aa-mobius77-cleanup-recovery/runbooks/Remove-Mobius77Staging"
        },
        "targetResourceGroupId": {
          "const": "resourceGroups/rg-solarplexus-mobius-77-staging"
        },
        "targetParameter": { "const": "TargetResourceGroupName" },
        "targetResourceGroup": {
          "const": "rg-solarplexus-mobius-77-staging"
        },
        "subscriptionFingerprint": { "$ref": "#/$defs/sha256" },
        "deadlineUtc": { "const": "2026-08-11T19:30:00Z" },
        "launchGraceSeconds": { "const": 1800 },
        "cleanupContributorRoleDefinitionId": {
          "const": "b24988ac-6180-42a0-ab88-20f7382dd24c"
        },
        "cleanupPrincipalFingerprintSha256": { "$ref": "#/$defs/sha256" },
        "deletionWaitSeconds": { "const": 2700 },
        "absenceVerificationSeconds": { "const": 300 },
        "publishedContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixedSkus": { "$ref": "#/$defs/stringMap" },
    "network": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "boolean"]
      },
      "required": [
        "vnetCidr",
        "containerAppsCidr",
        "privateEndpointsCidr",
        "managementCleanupCidr",
        "gatewayCidr",
        "azureFirewallCidr",
        "azureFirewallManagementCidr",
        "dnsResolverInboundCidr",
        "dnsResolverInboundAddress",
        "p2sClientCidr",
        "privateEndpointGroupId",
        "publicApplicationIngress",
        "publicKeyVaultAccess"
      ]
    },
    "networkQuotaRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["additiveHeadroom", "perResourceMinimum"],
      "properties": {
        "additiveHeadroom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "VirtualNetworks",
            "PublicIPAddresses",
            "IPv4StandardSkuPublicIpAddresses",
            "NetworkInterfaces",
            "PrivateEndpoints"
          ],
          "properties": {
            "VirtualNetworks": { "const": 1 },
            "PublicIPAddresses": { "const": 1 },
            "IPv4StandardSkuPublicIpAddresses": { "const": 1 },
            "NetworkInterfaces": { "const": 2 },
            "PrivateEndpoints": { "const": 2 }
          }
        },
        "perResourceMinimum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "SubnetsPerVirtualNetwork",
            "IPConfigurationsPerVirtualNetwork"
          ],
          "properties": {
            "SubnetsPerVirtualNetwork": { "const": 7 },
            "IPConfigurationsPerVirtualNetwork": { "const": 4 }
          }
        }
      }
    },
    "providerApiVersions": { "$ref": "#/$defs/stringMap" },
    "providerRegistrationRequirements": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rbac": { "$ref": "#/$defs/closedMap" },
    "vpn": { "$ref": "#/$defs/stringMap" },
    "providerRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smtpHost",
        "smtpPort",
        "smtpStartTls",
        "smtpFromAddress",
        "runtimeMode"
      ],
      "properties": {
        "smtpHost": { "const": "sandbox.smtp.mailtrap.io" },
        "smtpPort": { "const": 2525 },
        "smtpStartTls": { "const": true },
        "smtpFromAddress": {
          "const": "mobius77-validation@example.invalid"
        },
        "runtimeMode": { "const": "isolated-synthetic-private" }
      }
    },
    "privateAcrSource": { "$ref": "#/$defs/closedMap" },
    "secrets": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyVaultName",
          "containerAppReference",
          "environmentVariable"
        ],
        "properties": {
          "keyVaultName": { "type": "string", "minLength": 1 },
          "containerAppReference": { "type": "string", "minLength": 1 },
          "environmentVariable": { "type": "string", "minLength": 1 }
        }
      }
    },
    "manualSecretEntry": { "$ref": "#/$defs/closedMap" },
    "lifecycle": { "$ref": "#/$defs/closedMap" },
    "oneRunPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizationId",
        "maximumLedgerLifetimeSeconds",
        "maximumAttemptsPerOperation",
        "retryCount",
        "receiptRequiredBeforeFirstEffect",
        "replayDecision",
        "safePreSecretPreservationAllowed",
        "cleanupAuthorizedOnlyAfterCompletionOrExplicitUserApproval",
        "preservedResumeRequiresFreshLedger",
        "postRunProvisioningAuthorized"
      ],
      "properties": {
        "authorizationId": {
          "const": "m7.7-managed-binding-closeout-20260731"
        },
        "maximumLedgerLifetimeSeconds": { "const": 86400 },
        "maximumAttemptsPerOperation": { "const": 1 },
        "retryCount": { "const": 0 },
        "receiptRequiredBeforeFirstEffect": { "const": true },
        "replayDecision": { "const": "deny" },
        "safePreSecretPreservationAllowed": { "const": true },
        "cleanupAuthorizedOnlyAfterCompletionOrExplicitUserApproval": {
          "const": true
        },
        "preservedResumeRequiresFreshLedger": { "const": true },
        "postRunProvisioningAuthorized": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "stringMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "closedMap": {
      "type": "object",
      "minProperties": 1
    }
  }
}
