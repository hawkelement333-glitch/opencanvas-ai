{
  "version": "mobius-alerts-v1",
  "defaults": {
    "owner": "platform-operations",
    "escalation": "incident-commander",
    "objective": "mobius-internal-slos-v1",
    "safeDiagnosticFields": [
      "alertId",
      "environment",
      "deployment",
      "component",
      "outcome",
      "failureClass"
    ],
    "rawContent": false
  },
  "alerts": [
    {
      "id": "api-latency-v1",
      "signal": "mobius.api.duration",
      "query": "p95 over 5m >= 1000 ms for two windows",
      "threshold": 1000,
      "evaluationWindowMinutes": 5,
      "firingRule": "two consecutive breaches",
      "recoveryRule": "two consecutive windows below 750 ms",
      "missingData": "hold",
      "severity": "warning",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#api-degradation",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "readiness-v1",
      "signal": "readiness",
      "query": "ready failures over 5m >= 3",
      "threshold": 3,
      "evaluationWindowMinutes": 5,
      "firingRule": "three failures",
      "recoveryRule": "three consecutive successes",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "deployment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#liveness-or-readiness-failure",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "database-saturation-v1",
      "signal": "mobius.database.pool.acquire",
      "query": "p95 over 5m >= 500 ms or timeout count > 0",
      "threshold": 500,
      "evaluationWindowMinutes": 5,
      "firingRule": "two consecutive breaches",
      "recoveryRule": "three windows below 250 ms and zero timeouts",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "deployment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#database-saturation-or-outage",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "storage-outage-v1",
      "signal": "mobius.storage.failures",
      "query": "failure rate over 5m >= 0.05",
      "threshold": 0.05,
      "evaluationWindowMinutes": 5,
      "firingRule": "two consecutive breaches",
      "recoveryRule": "three windows below 0.01",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#storage-outage",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "scanner-outage-v1",
      "signal": "mobius.scanner.unavailable",
      "query": "unavailable verdict count over 5m >= 1",
      "threshold": 1,
      "evaluationWindowMinutes": 5,
      "firingRule": "one breach",
      "recoveryRule": "three healthy probes",
      "missingData": "breach",
      "severity": "critical",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#scanner-outage",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "queue-backlog-v1",
      "signal": "mobius.queue.oldest_age",
      "query": "max over 5m >= 300 s",
      "threshold": 300,
      "evaluationWindowMinutes": 5,
      "firingRule": "two consecutive breaches",
      "recoveryRule": "two windows below 120 s",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "deployment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#queue-backlog-retry-storm-or-dead-letter-growth",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "worker-stale-v1",
      "signal": "worker-heartbeat",
      "query": "fresh worker count == 0 for 2m",
      "threshold": 0,
      "comparison": "lte",
      "evaluationWindowMinutes": 2,
      "firingRule": "two missing heartbeats",
      "recoveryRule": "two fresh heartbeats",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "deployment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#lost-or-stale-worker",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "limiter-outage-v1",
      "signal": "mobius.limiter.health",
      "query": "minimum over 2m < 1",
      "threshold": 1,
      "comparison": "lte",
      "evaluationWindowMinutes": 2,
      "firingRule": "one unavailable decision",
      "recoveryRule": "three healthy decisions",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#limiter-saturation-or-outage",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "indexer-freshness-v1",
      "signal": "mobius.indexer.freshness",
      "query": "max over 15m >= 900 s or drift > 0",
      "threshold": 900,
      "evaluationWindowMinutes": 15,
      "firingRule": "two consecutive breaches",
      "recoveryRule": "two windows below 300 s and zero drift",
      "missingData": "hold",
      "severity": "high",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#indexer-backlog-drift-or-freshness-failure",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "provider-degradation-v1",
      "signal": "mobius.provider.calls",
      "query": "failure rate over 10m >= 0.05",
      "threshold": 0.05,
      "evaluationWindowMinutes": 10,
      "firingRule": "two consecutive breaches",
      "recoveryRule": "three windows below 0.01",
      "missingData": "hold",
      "severity": "warning",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#provider-degradation-or-cost-spike",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "outbox-backlog-v1",
      "signal": "mobius.outbox.oldest_age",
      "query": "max over 5m >= 300 s or terminal failure > 0",
      "threshold": 300,
      "evaluationWindowMinutes": 5,
      "firingRule": "two consecutive breaches or one terminal failure",
      "recoveryRule": "two windows below 120 s and zero terminal failures",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "deployment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#domain-event-or-outbox-backlog",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "evidence-integrity-v1",
      "signal": "mobius.evidence.integrity",
      "query": "max finding count over 5m > 0",
      "threshold": 1,
      "evaluationWindowMinutes": 5,
      "firingRule": "one finding",
      "recoveryRule": "authorized investigation closes finding; monitor never repairs",
      "missingData": "breach",
      "severity": "critical",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#audit-or-product-trace-integrity-alert",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "telemetry-loss-v1",
      "signal": "mobius.telemetry.dropped",
      "query": "sum over 5m >= 1 or exporter unavailable",
      "threshold": 1,
      "evaluationWindowMinutes": 5,
      "firingRule": "one dropped signal or three export failures",
      "recoveryRule": "three successful exports with empty bounded buffer",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "deployment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#telemetry-exporter-outage-backpressure-or-cardinality-breach",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "backup-freshness-v1",
      "signal": "mobius.backup.freshness",
      "query": "latest provider freshness prerequisite >= 86400 s",
      "threshold": 86400,
      "evaluationWindowMinutes": 1440,
      "firingRule": "one breach",
      "recoveryRule": "fresh provider evidence observed",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#backup-freshness-alert",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "capacity-v1",
      "signal": "mobius.capacity.utilization",
      "query": "max over 15m >= 0.8",
      "threshold": 0.8,
      "evaluationWindowMinutes": 15,
      "firingRule": "three consecutive breaches",
      "recoveryRule": "three windows below 0.65",
      "missingData": "hold",
      "severity": "warning",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#capacity-exhaustion",
      "objective": "mobius-internal-slos-v1"
    },
    {
      "id": "cost-v1",
      "signal": "mobius.cost.estimated",
      "query": "forecast exceeds server-owned operating ceiling",
      "threshold": 0.8,
      "evaluationWindowMinutes": 1440,
      "firingRule": "one forecast breach",
      "recoveryRule": "forecast returns below 0.7 after authorized mitigation",
      "missingData": "breach",
      "severity": "high",
      "groupBy": ["alertId", "environment"],
      "runbook": "../OBSERVABILITY_OPERATIONS_RUNBOOK.md#provider-degradation-or-cost-spike",
      "objective": "mobius-internal-slos-v1"
    }
  ]
}
