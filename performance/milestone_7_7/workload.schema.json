{
  "$id": "urn:solarplexus:mobius:milestone-7.7:workload:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertions": {
      "items": {
        "enum": [
          "all-results-schema-valid",
          "no-cross-tenant-attribution",
          "no-output-limit-breach",
          "required-outcomes-observed",
          "stop-conditions-respected"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "contractVersion": {
      "const": "mobius.m7.7.workload.v1"
    },
    "dataPolicy": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "isolated-synthetic"
        },
        "externalTargetsAllowed": {
          "const": false
        },
        "productionDataProhibited": {
          "const": true
        },
        "secretsProhibited": {
          "const": true
        }
      },
      "required": [
        "classification",
        "externalTargetsAllowed",
        "productionDataProhibited",
        "secretsProhibited"
      ],
      "type": "object"
    },
    "expectedOutcomeClasses": {
      "items": {
        "enum": [
          "success",
          "rate-limited",
          "dependency-unavailable",
          "timeout",
          "client-error",
          "server-error"
        ],
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "identities": {
      "additionalProperties": false,
      "properties": {
        "agentsPerWorkspace": {
          "maximum": 16,
          "minimum": 0,
          "type": "integer"
        },
        "canvasesPerWorkspace": {
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "documentsPerWorkspace": {
          "maximum": 64,
          "minimum": 0,
          "type": "integer"
        },
        "objectsPerDocument": {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        },
        "tenantCount": {
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "usersPerTenant": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "workflowsPerWorkspace": {
          "maximum": 16,
          "minimum": 0,
          "type": "integer"
        },
        "workspacesPerTenant": {
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "tenantCount",
        "usersPerTenant",
        "workspacesPerTenant",
        "canvasesPerWorkspace",
        "documentsPerWorkspace",
        "objectsPerDocument",
        "workflowsPerWorkspace",
        "agentsPerWorkspace"
      ],
      "type": "object"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "maxArrivalRatePerSecond": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "maxGeneratedEntities": {
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        },
        "maxMeasurementSeries": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "maxObjectBytes": {
          "maximum": 16777216,
          "minimum": 0,
          "type": "integer"
        },
        "maxOutputBytes": {
          "maximum": 4194304,
          "minimum": 1024,
          "type": "integer"
        },
        "maxRequestBytes": {
          "maximum": 1048576,
          "minimum": 0,
          "type": "integer"
        },
        "maxRetries": {
          "maximum": 2,
          "minimum": 0,
          "type": "integer"
        },
        "maxTenantCount": {
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "maxTotalObjectBytes": {
          "maximum": 134217728,
          "minimum": 0,
          "type": "integer"
        },
        "maximumConcurrency": {
          "maximum": 128,
          "minimum": 1,
          "type": "integer"
        },
        "maximumDurationMs": {
          "maximum": 14400000,
          "minimum": 1,
          "type": "integer"
        },
        "maximumRequests": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "requestTimeoutMs": {
          "maximum": 120000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "maximumDurationMs",
        "maximumRequests",
        "maximumConcurrency",
        "maxArrivalRatePerSecond",
        "requestTimeoutMs",
        "maxRetries",
        "maxRequestBytes",
        "maxObjectBytes",
        "maxTotalObjectBytes",
        "maxGeneratedEntities",
        "maxTenantCount",
        "maxMeasurementSeries",
        "maxOutputBytes"
      ],
      "type": "object"
    },
    "loadModel": {
      "additionalProperties": false,
      "properties": {
        "arrivalRatePerSecond": {
          "maximum": 100,
          "minimum": 1,
          "type": ["integer", "null"]
        },
        "concurrency": {
          "maximum": 128,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "enum": ["arrival-rate", "closed-concurrency"],
          "type": "string"
        }
      },
      "required": ["type", "concurrency", "arrivalRatePerSecond"],
      "type": "object"
    },
    "measurement": {
      "additionalProperties": false,
      "properties": {
        "clockSource": {
          "const": "logical-monotonic-microseconds"
        },
        "excludePhaseKinds": {
          "const": ["warmup", "cooldown"]
        },
        "includeFailureLatencies": {
          "type": "boolean"
        },
        "includeTimeoutLatencies": {
          "type": "boolean"
        },
        "latencyUnit": {
          "const": "microseconds"
        },
        "percentileMethod": {
          "const": "nearest-rank"
        },
        "percentilesBasisPoints": {
          "const": [5000, 9500, 9900]
        },
        "rateScale": {
          "const": "basis-points"
        },
        "throughputUnit": {
          "const": "milli-requests-per-second"
        }
      },
      "required": [
        "percentilesBasisPoints",
        "percentileMethod",
        "latencyUnit",
        "throughputUnit",
        "rateScale",
        "clockSource",
        "excludePhaseKinds",
        "includeTimeoutLatencies",
        "includeFailureLatencies"
      ],
      "type": "object"
    },
    "operations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expectedOutcomes": {
            "items": {
              "enum": [
                "success",
                "rate-limited",
                "dependency-unavailable",
                "timeout",
                "client-error",
                "server-error"
              ],
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "operationId": {
            "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
            "type": "string"
          },
          "weight": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": ["operationId", "weight", "expectedOutcomes"],
        "type": "object"
      },
      "maxItems": 9,
      "minItems": 1,
      "type": "array"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "canonical-json"
        },
        "includeHeaders": {
          "const": false
        },
        "includeRawIdentifiers": {
          "const": false
        },
        "includeRequestBodies": {
          "const": false
        },
        "maxBytes": {
          "maximum": 4194304,
          "minimum": 1024,
          "type": "integer"
        }
      },
      "required": [
        "format",
        "includeRequestBodies",
        "includeHeaders",
        "includeRawIdentifiers",
        "maxBytes"
      ],
      "type": "object"
    },
    "phases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "durationMs": {
            "maximum": 14400000,
            "minimum": 1,
            "type": "integer"
          },
          "kind": {
            "enum": ["warmup", "measurement", "cooldown"],
            "type": "string"
          },
          "requestCount": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": ["kind", "durationMs", "requestCount"],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "purpose": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[ -~]+$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "2020-12"
    },
    "seed": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "stopConditions": {
      "additionalProperties": false,
      "properties": {
        "maxErrorRateBasisPoints": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "maxFailures": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "maxTimeouts": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "stopOnAssertionFailure": {
          "const": true
        }
      },
      "required": [
        "maxFailures",
        "maxTimeouts",
        "maxErrorRateBasisPoints",
        "stopOnAssertionFailure"
      ],
      "type": "object"
    },
    "tenantDistribution": {
      "enum": ["round-robin", "weighted-noisy-neighbor"],
      "type": "string"
    },
    "workloadId": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "workloadType": {
      "enum": [
        "baseline",
        "sustained",
        "spike",
        "bounded-stress",
        "bounded-soak",
        "mixed",
        "noisy-neighbor",
        "hostile-authorized-concurrency",
        "horizontal-scaling-preparation"
      ],
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "schemaVersion",
    "workloadId",
    "purpose",
    "workloadType",
    "seed",
    "dataPolicy",
    "identities",
    "operations",
    "phases",
    "loadModel",
    "limits",
    "tenantDistribution",
    "expectedOutcomeClasses",
    "assertions",
    "stopConditions",
    "measurement",
    "output"
  ],
  "title": "SolarPlexus Mobius Milestone 7.7 workload manifest",
  "type": "object"
}
