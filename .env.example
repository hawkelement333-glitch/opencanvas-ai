# SolarPlexus Mobius configuration template — placeholders and safe local defaults only.
# Copy to .env for local development. Never commit .env or real credentials.

# Runtime identity: demo | development | test | staging | production
# Demo must be started with `pnpm demo`; do not hand-build demo settings from this file.
APP_MODE=development
OPENCANVAS_APP_URL=http://localhost:3000
OPENCANVAS_API_PREFIX=/api/v1
OPENCANVAS_CORS_ORIGINS=["http://localhost:3000"]

# Database
OPENCANVAS_DATABASE_URL=postgresql+asyncpg://opencanvas:opencanvas@localhost:5432/opencanvas
# api | worker | migration | backup | observability | emergency. Each deployed process receives
# exactly one dedicated credential; never inject migration credentials into the API or worker.
OPENCANVAS_DATABASE_ROLE=api
OPENCANVAS_DATABASE_POOL_SIZE=10
OPENCANVAS_DATABASE_MAX_OVERFLOW=0
OPENCANVAS_DATABASE_POOL_TIMEOUT_SECONDS=15
OPENCANVAS_DATABASE_POOL_RECYCLE_SECONDS=1800
OPENCANVAS_DATABASE_CONNECT_TIMEOUT_SECONDS=10
OPENCANVAS_DATABASE_STATEMENT_TIMEOUT_MS=30000
OPENCANVAS_DATABASE_LOCK_TIMEOUT_MS=5000
OPENCANVAS_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
# Local PostgreSQL uses disable. Staging and production require verify-full.
OPENCANVAS_DATABASE_TLS_MODE=disable
OPENCANVAS_DATABASE_APPLICATION_NAME=solarplexus-mobius
OPENCANVAS_DATABASE_EXPECTED_REVISION=20260726_0028

# Authentication and sessions
OPENCANVAS_AUTH_ENABLED=true
OPENCANVAS_AUTH_TEST_BYPASS=false
# Replace in every shared/deployed environment with at least 32 random bytes.
OPENCANVAS_SESSION_SECRET=development-only-session-secret-change-before-deploying
# Keep this distinct from the session secret; persisted invitation tokens are HMAC digests only.
OPENCANVAS_INVITATION_SECRET=development-only-invitation-secret-change-before-deploying
OPENCANVAS_SESSION_COOKIE_NAME=mobius_session
OPENCANVAS_SESSION_TTL_MINUTES=10080
OPENCANVAS_SESSION_SAME_SITE=lax
OPENCANVAS_CSRF_HEADER_NAME=X-CSRF-Token
OPENCANVAS_PASSWORD_RESET_TTL_MINUTES=30
# development_token is local-only. Staging/production require smtp.
OPENCANVAS_PASSWORD_RESET_PROVIDER=development_token
OPENCANVAS_SMTP_HOST=
OPENCANVAS_SMTP_PORT=587
OPENCANVAS_SMTP_USERNAME=
OPENCANVAS_SMTP_PASSWORD=
OPENCANVAS_SMTP_FROM_ADDRESS=
OPENCANVAS_SMTP_STARTTLS=true

# AI and embeddings — provider selection is always explicit; there is no mock fallback.
OPENCANVAS_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENCANVAS_OPENAI_MODEL=gpt-5.6-terra
OPENCANVAS_OPENAI_TIMEOUT_SECONDS=45
OPENCANVAS_AI_PROVIDER_CONFIGURATION_VERSION=openai-responses-v1
OPENCANVAS_AI_CONTEXT_CHARACTER_LIMIT=60000
OPENCANVAS_AI_MAX_OUTPUT_TOKENS=1600
OPENCANVAS_EMBEDDING_PROVIDER=mock
OPENCANVAS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENCANVAS_EMBEDDING_DIMENSIONS=1536
OPENCANVAS_EMBEDDING_BATCH_SIZE=64
OPENCANVAS_EMBEDDING_PROVIDER_CONFIGURATION_VERSION=openai-embeddings-v1

# Private file storage: local for development/test; Azure Blob for staging/production.
OPENCANVAS_STORAGE_PROVIDER=local
OPENCANVAS_DOCUMENT_STORAGE_ROOT=./data/documents
# Legacy S3-compatible settings remain available only for local compatibility.
OPENCANVAS_OBJECT_STORAGE_BUCKET=
OPENCANVAS_OBJECT_STORAGE_REGION=us-east-1
OPENCANVAS_OBJECT_STORAGE_ENDPOINT=
OPENCANVAS_OBJECT_STORAGE_ACCESS_KEY_ID=
OPENCANVAS_OBJECT_STORAGE_SECRET_ACCESS_KEY=
OPENCANVAS_OBJECT_STORAGE_PREFIX=mobius
OPENCANVAS_OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Staging/production require a private versioned Azure account, four distinct
# security-class containers, and workload identity. Do not put credentials in Git.
OPENCANVAS_AZURE_STORAGE_ACCOUNT_URL=
OPENCANVAS_AZURE_QUARANTINE_CONTAINER=quarantine
OPENCANVAS_AZURE_CLEAN_CONTAINER=clean
OPENCANVAS_AZURE_REJECTED_CONTAINER=rejected
OPENCANVAS_AZURE_RETAINED_CONTAINER=retained
OPENCANVAS_AZURE_MANAGED_IDENTITY_ENDPOINT=
OPENCANVAS_AZURE_MANAGED_IDENTITY_HEADER=

# Secure object ingestion: disabled | deterministic | trusted.
# Staging/production require trusted. These two secrets must be unique, server-only,
# at least 32 bytes, and distinct from session and invitation secrets.
OPENCANVAS_OBJECT_INGESTION_MODE=disabled
OPENCANVAS_UPLOAD_CAPABILITY_SECRET=development-only-upload-capability-secret-change-before-deploying
OPENCANVAS_SCANNER_RESULT_SECRET=development-only-scanner-result-secret-change-before-deploying
OPENCANVAS_UPLOAD_CAPABILITY_TTL_SECONDS=300
OPENCANVAS_UPLOAD_MAX_ACTIVE_SESSIONS_PER_WORKSPACE=10
OPENCANVAS_SCANNER_RESULT_REQUESTS_PER_MINUTE=120
OPENCANVAS_MALWARE_SCAN_TIMEOUT_SECONDS=300
OPENCANVAS_MALWARE_SCAN_RESULT_MAX_AGE_SECONDS=86400
OPENCANVAS_MALWARE_SCANNER_IDENTITY=deterministic-test-scanner
OPENCANVAS_MALWARE_SCANNER_VERSION=v1
OPENCANVAS_MALWARE_POLICY_VERSION=mobius-malware-policy-v1
OPENCANVAS_OBJECT_PROMOTION_SERVICE_IDENTITY=mobius-object-promotion

# Durable document jobs
OPENCANVAS_JOB_PROVIDER=database
OPENCANVAS_WORKER_POLL_INTERVAL_SECONDS=1
OPENCANVAS_WORKER_HEARTBEAT_SECONDS=15
OPENCANVAS_WORKER_STALE_AFTER_SECONDS=120
OPENCANVAS_PROCESSING_RETRY_LIMIT=3
OPENCANVAS_PROCESSING_RETRY_BASE_SECONDS=5
OPENCANVAS_PROCESSING_RETRY_MAX_SECONDS=900
OPENCANVAS_PROCESSING_MAX_CONCURRENT_PER_WORKSPACE=3
OPENCANVAS_PROCESSING_MAX_CONCURRENT_GLOBAL=32
OPENCANVAS_PROCESSING_LEASE_SECONDS=60
OPENCANVAS_PROCESSING_JOB_DEADLINE_SECONDS=3600

# Shared rate limits: memory is an explicit local/demo fake only. Staging and
# production require private Managed Redis over rediss, Entra managed identity,
# a deployment-unique username/ACL, and a distinct server-only HMAC secret.
OPENCANVAS_SHARED_RATE_LIMIT_PROVIDER=memory
OPENCANVAS_SHARED_RATE_LIMIT_AUTH_MODE=entra
OPENCANVAS_SHARED_RATE_LIMIT_REDIS_URL=
OPENCANVAS_SHARED_RATE_LIMIT_REDIS_USERNAME=
OPENCANVAS_SHARED_RATE_LIMIT_IDENTITY_ENDPOINT=
OPENCANVAS_SHARED_RATE_LIMIT_IDENTITY_HEADER=
# Recovery-only ACL values are mounted secret files, never URL credentials.
# They require APP_MODE=recovery, a loopback rediss endpoint, verified TLS,
# and an explicit per-recovery limiter epoch. Staging and production refuse them.
OPENCANVAS_SHARED_RATE_LIMIT_ACL_USERNAME_FILE=
OPENCANVAS_SHARED_RATE_LIMIT_ACL_PASSWORD_FILE=
OPENCANVAS_SHARED_RATE_LIMIT_TLS_CA_FILE=
OPENCANVAS_SHARED_RATE_LIMIT_RECOVERY_EPOCH=
OPENCANVAS_SHARED_RATE_LIMIT_HMAC_SECRET=development-only-rate-limit-secret-change-before-deploying
OPENCANVAS_SHARED_RATE_LIMIT_NAMESPACE=mobius
OPENCANVAS_SHARED_RATE_LIMIT_DEPLOYMENT=local
OPENCANVAS_SHARED_RATE_LIMIT_CONNECT_TIMEOUT_SECONDS=2
OPENCANVAS_SHARED_RATE_LIMIT_OPERATION_TIMEOUT_SECONDS=1
OPENCANVAS_SHARED_RATE_LIMIT_EMERGENCY_REQUESTS_PER_MINUTE=10000

# Upload, extraction, retrieval, request, and abuse limits
OPENCANVAS_DOCUMENT_MAX_FILE_SIZE_BYTES=26214400
OPENCANVAS_DOCUMENT_MAX_FILES_PER_REQUEST=10
OPENCANVAS_DOCUMENT_CHUNK_SIZE_CHARS=2000
OPENCANVAS_DOCUMENT_CHUNK_OVERLAP_CHARS=300
OPENCANVAS_DOCUMENT_MAX_PDF_PAGES=500
OPENCANVAS_DOCUMENT_MAX_EXTRACTED_CHARACTERS=5000000
OPENCANVAS_DOCUMENT_DOCX_MAX_MEMBERS=2000
OPENCANVAS_DOCUMENT_DOCX_MAX_UNCOMPRESSED_BYTES=104857600
OPENCANVAS_DOCUMENT_DOCX_MAX_COMPRESSION_RATIO=100
OPENCANVAS_DOCUMENT_RETRIEVAL_TOP_K=8
OPENCANVAS_DOCUMENT_RELEVANCE_THRESHOLD=0.2
OPENCANVAS_REQUEST_MAX_BODY_BYTES=31457280
OPENCANVAS_QUESTION_MAX_CHARACTERS=8000
OPENCANVAS_REQUESTS_PER_USER_PER_MINUTE=120
OPENCANVAS_REQUESTS_PER_WORKSPACE_PER_MINUTE=300
OPENCANVAS_AI_REQUESTS_PER_USER_PER_MINUTE=20
OPENCANVAS_AUTH_REQUESTS_PER_IP_PER_MINUTE=10
OPENCANVAS_MONTHLY_TOKEN_BUDGET_PER_WORKSPACE=2000000
OPENCANVAS_ESTIMATED_INPUT_COST_PER_MILLION_TOKENS=0
OPENCANVAS_ESTIMATED_OUTPUT_COST_PER_MILLION_TOKENS=0

# Observability
OPENCANVAS_LOG_LEVEL=INFO
OPENCANVAS_LOG_JSON=true
OPENCANVAS_ERROR_TRACKING_DSN=
OPENCANVAS_TELEMETRY_ENABLED=false
OPENCANVAS_TELEMETRY_EXPORTER=disabled
OPENCANVAS_TELEMETRY_ENDPOINT=
OPENCANVAS_TELEMETRY_SERVICE_NAME=opencanvas-api
OPENCANVAS_TELEMETRY_RELEASE=local-development
OPENCANVAS_TELEMETRY_DEPLOYMENT=local
OPENCANVAS_TELEMETRY_AUTH_SECRET_REFERENCE=
OPENCANVAS_TELEMETRY_TLS_VERIFY=true
OPENCANVAS_TELEMETRY_EXPORT_TIMEOUT_SECONDS=2
OPENCANVAS_TELEMETRY_SHUTDOWN_TIMEOUT_SECONDS=3
OPENCANVAS_TELEMETRY_BATCH_SIZE=64
OPENCANVAS_TELEMETRY_BUFFER_SIZE=1024
OPENCANVAS_TELEMETRY_RETRY_LIMIT=2
OPENCANVAS_TELEMETRY_SAMPLE_RATIO=0.1
OPENCANVAS_TELEMETRY_MAX_SPAN_DEPTH=16
OPENCANVAS_TELEMETRY_MAX_SPAN_EVENTS=16
OPENCANVAS_TELEMETRY_MAX_SPAN_ATTRIBUTES=16
OPENCANVAS_TELEMETRY_PSEUDONYMIZATION_SECRET=development-only-telemetry-secret-change-before-deploying
OPENCANVAS_TELEMETRY_BAGGAGE_ALLOWLIST=["operation","component"]
OPENCANVAS_TELEMETRY_CARDINALITY_BUDGET=128
OPENCANVAS_TELEMETRY_HEALTH_FAILURE_THRESHOLD=3
OPENCANVAS_TELEMETRY_APPLICATION_LOG_RETENTION_DAYS=30
OPENCANVAS_TELEMETRY_SECURITY_LOG_RETENTION_DAYS=90
OPENCANVAS_TELEMETRY_METRIC_RETENTION_DAYS=30
OPENCANVAS_TELEMETRY_TRACE_RETENTION_DAYS=14
OPENCANVAS_TELEMETRY_INCIDENT_RETENTION_DAYS=365
OPENCANVAS_TELEMETRY_OBJECTIVE_VERSION=mobius-internal-slos-v1
OPENCANVAS_TELEMETRY_QUEUE_AGE_ALERT_SECONDS=300
OPENCANVAS_TELEMETRY_ERROR_RATE_ALERT_RATIO=0.05
OPENCANVAS_TELEMETRY_DROPPED_SIGNAL_ALERT_COUNT=1
OPENCANVAS_OBSERVABILITY_OPERATOR_USER_IDS=[]
OPENCANVAS_CORRELATION_HEADER_NAME=X-Request-ID

# Browser-safe build setting. Never put a secret in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CSRF_COOKIE_NAME=mobius_session_csrf
